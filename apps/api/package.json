{
  "name": "pishgaman",
  "version": "0.1.0",
  "private": true,
  "description": "Pishgaman Monorepo",
  "license": "UNLICENSED",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8"
  }
}