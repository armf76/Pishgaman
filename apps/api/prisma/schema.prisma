generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PartyType {
  PERSON
  ORGANIZATION
}

enum PartyStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum PartyRoleType {
  APPLICANT
  OWNER
  ATTORNEY
  EXPERT
  EMPLOYEE
  NOTARY
  ADMIN
}

enum ContactType {
  MOBILE
  PHONE
  EMAIL
  WEBSITE
}

enum DocumentType {
  NATIONAL_CARD
  BIRTH_CERTIFICATE
  PASSPORT
  COMPANY_REGISTRATION
  POWER_OF_ATTORNEY
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEED_DOCUMENT
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum CaseDocumentStatus {
  REQUIRED
  UPLOADED
  VERIFIED
  REJECTED
}

enum CaseDocumentType {
  NATIONAL_CARD
  BIRTH_CERTIFICATE
  PASSPORT
  OWNERSHIP_DOCUMENT
  POWER_OF_ATTORNEY
  COMPANY_DOCUMENT
  OTHER
}

enum CaseAuditAction {
  CREATED
  UPDATED
  SUBMITTED
  REVIEWED
  DOCUMENT_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  DOCUMENT_DELETED
  APPROVAL_BLOCKED
}

model Party {
  id        String      @id @default(uuid())
  partyType PartyType
  status    PartyStatus @default(ACTIVE)

  displayName String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  person       Person?
  organization Organization?

  contacts     Contact[]
  addresses    Address[]
  roles        PartyRole[]
  documents    IdentityDocument[]
  bankAccounts BankAccount[]

  cases Case[]

  @@index([displayName])
}

model Person {
  id String @id @default(uuid())

  partyId String @unique
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  firstName  String
  lastName   String
  fatherName String?

  nationalCode String    @unique
  birthDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id String @id @default(uuid())

  partyId String @unique
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  companyName String

  registrationNumber String  @unique
  nationalId         String? @unique
  economicCode       String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartyRole {
  id String @id @default(uuid())

  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  role PartyRoleType

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([partyId, role])
}

model Contact {
  id String @id @default(uuid())

  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  type  ContactType
  value String

  primary  Boolean @default(false)
  verified Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([partyId])
}

model Address {
  id String @id @default(uuid())

  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  province String
  city     String

  postalCode String?

  address String

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())

  @@index([partyId])
}

model IdentityDocument {
  id String @id @default(uuid())

  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  type DocumentType

  number String

  issueDate  DateTime?
  expireDate DateTime?

  filePath String?

  createdAt DateTime @default(now())

  @@index([partyId])
}

model BankAccount {
  id String @id @default(uuid())

  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  bankName String

  iban String @unique

  cardNumber String?

  ownerName String

  createdAt DateTime @default(now())

  @@index([partyId])
}

model Case {
  id String @id @default(uuid())

  caseNumber String @unique

  applicantPartyId String
  applicant        Party  @relation(fields: [applicantPartyId], references: [id])

  title       String
  description String?

  status CaseStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseDocuments CaseDocument[]
  audits        CaseAudit[]

  @@index([caseNumber])
  @@index([status])
  @@index([applicantPartyId])
}

model CaseDocument {
  id String @id @default(uuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  type  CaseDocumentType
  title String

  status CaseDocumentStatus @default(REQUIRED)

  filePath        String?
  rejectionReason String?

  uploadedAt DateTime?
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audits CaseAudit[]

  @@unique([caseId, type])
  @@index([caseId])
  @@index([status])
}

model CaseAudit {
  id String @id @default(uuid())

  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  action CaseAuditAction

  fromStatus CaseStatus?
  toStatus   CaseStatus?

  documentId String?
  document   CaseDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  description String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([action])
  @@index([documentId])
  @@index([createdAt])
}
